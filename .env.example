# Copia este archivo a .env solo si vas a usar los avisos con la app cerrada
# (Web Push). Sin esto, la app funciona igual pero Web Push queda desactivado.

# Genera un par de claves con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Correo o URL de contacto que se envía al servicio de push como responsable.
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# Secreto para disparar POST /api/push/check desde una tarea programada.
CRON_SECRET=

# URL pública de la app (para armar los enlaces del chequeo periódico).
APP_URL="http://localhost:3000"
